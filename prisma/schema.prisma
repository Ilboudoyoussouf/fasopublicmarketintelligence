// FASO Public Market Intelligence — modèle de données universel
// Ref: cahier des charges section 4 (architecture métier), section 42 (BDD logique),
// sections 7-19 (données à extraire), section 98 (prêt multi-pays).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// 0. RÉFÉRENTIEL PAYS / GÉOGRAPHIE (section 98 — pas de champs Burkina-only)
// =====================================================================

model Country {
  id                  String   @id @default(cuid())
  code                String   @unique // ISO alpha-2, ex "BF"
  name                String
  regulationFramework String? // ex "Code des marchés publics du Burkina Faso"
  primarySourceName   String? // ex "DGCMEF"
  primarySourceUrl    String?
  currency            String   @default("XOF")
  createdAt           DateTime @default(now())

  regions                Region[]
  contractingAuthorities ContractingAuthority[]
  companies              Company[]
  sources                Source[]
  tenants                Tenant[]
}

model Region {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  name      String
  code      String?

  provinces Province[]
  markets   Market[]

  @@unique([countryId, name])
}

model Province {
  id       String  @id @default(cuid())
  regionId String
  region   Region  @relation(fields: [regionId], references: [id])
  name     String
  code     String?

  communes Commune[]

  @@unique([regionId, name])
}

model Commune {
  id         String   @id @default(cuid())
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])
  name       String

  @@unique([provinceId, name])
}

// =====================================================================
// 1. SOURCE DOCUMENTAIRE — Publication → Document → Page (section 2.1, 3, 54)
// =====================================================================

enum PublicationKind {
  QUOTIDIEN_MARCHES
  AVIS_GENERAL
  PPM
  DOCUMENT_REGLEMENTAIRE
  DOCUMENT_STATISTIQUE
  AUTRE
}

model Source {
  id            String    @id @default(cuid())
  countryId     String
  country       Country   @relation(fields: [countryId], references: [id])
  name          String // "DGCMEF"
  baseUrl       String
  isActive      Boolean   @default(true)
  lastCrawledAt DateTime?
  createdAt     DateTime  @default(now())

  publications Publication[]
}

// Une Publication = un événement de parution (peut regrouper plusieurs
// fichiers : principal + bis, ou un numéro double dans un seul fichier).
model Publication {
  id            String          @id @default(cuid())
  sourceId      String
  source        Source          @relation(fields: [sourceId], references: [id])
  kind          PublicationKind
  numero        String // ex "4477" ou "4473-4474"
  isDoubleIssue Boolean         @default(false)
  publishedAt   DateTime
  title         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  documents           Document[]
  notices             Notice[]
  ppmPlans            PpmPlan[]
  generalNotices      GeneralNotice[]
  supplierDirectories SupplierDirectory[]

  @@unique([sourceId, numero, kind])
  @@index([publishedAt])
}

enum ExtractionStatus {
  PENDING
  DOWNLOADED
  OCR_DONE
  PARSED
  CLASSIFIED
  EXTRACTED
  VALIDATED
  FAILED
}

model Document {
  id               String           @id @default(cuid())
  publicationId    String
  publication      Publication      @relation(fields: [publicationId], references: [id])
  filename         String
  url              String
  fileHash         String?
  sizeBytes        Int?
  mimeType         String?
  isPrincipal      Boolean          @default(true)
  isBis            Boolean          @default(false)
  extractionStatus ExtractionStatus @default(PENDING)
  downloadedAt     DateTime?
  createdAt        DateTime         @default(now())

  // Résultat d'une extraction Gemini menée en arrière-plan, en attente de
  // validation humaine (aperçu avant ajout, section admin/sources) —
  // {status: "ok", notices, truncated, invalidCount, publicationNumero,
  // publishedAt} | {status: "gemini_not_configured"} | {status:
  // "extraction_failed", error}. Effacé (remis à null) dès que l'admin
  // valide (commitAnalyzedDocument) ou relance une analyse. Existe car
  // l'extraction est lancée sans être attendue par la requête HTTP qui l'a
  // déclenchée (peut prendre plusieurs minutes sur un gros document — bien
  // au-delà de ce que tolère le proxy inverse devant l'hébergement) : le
  // client récupère le résultat par des requêtes courtes (polling) plutôt
  // que de garder une requête ouverte tout ce temps.
  pendingAnalysis Json?

  pages               DocumentPage[]
  extractionJobs      ExtractionJob[]
  notices             Notice[]
  corrections         Correction[]
  cancellations       Cancellation[]
  republications      Republication[]
  results             Result[]
  appeals             Appeal[]
  marketEvents        MarketEvent[]
  ppmItems            PpmItem[]
  supplierDirectories SupplierDirectory[]
  blockHashes         BlockHash[]

  @@unique([url])
  @@index([publicationId])
}

model DocumentPage {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id])
  pageNumber    Int
  rawText       String? @db.Text
  ocrConfidence Float?
  createdAt     DateTime @default(now())

  @@unique([documentId, pageNumber])
}

// =====================================================================
// 2. ORGANISMES (autorités contractantes) — section "Autorité contractante"
// =====================================================================

enum OrganizationType {
  MINISTERE
  INSTITUTION
  EPE
  REGION
  PROVINCE
  COMMUNE
  PROJET
  AUTRE
}

model ContractingAuthority {
  id               String                 @id @default(cuid())
  countryId        String
  country          Country                @relation(fields: [countryId], references: [id])
  name             String
  type             OrganizationType
  parentId         String?
  parent           ContractingAuthority?  @relation("AuthorityHierarchy", fields: [parentId], references: [id])
  children         ContractingAuthority[] @relation("AuthorityHierarchy")
  regionName       String?
  provinceName     String?
  communeName      String?
  delegatedManager String? // maître d'ouvrage délégué
  createdAt        DateTime               @default(now())

  markets             Market[]
  ppmPlans            PpmPlan[]
  generalNotices      GeneralNotice[]
  supplierDirectories SupplierDirectory[]

  @@unique([countryId, name])
}

// =====================================================================
// 3. TAXONOMIE (section 5, admin-extensible — section 91)
// =====================================================================

enum SectorGroup {
  FOURNITURES_SERVICES
  TRAVAUX
  PRESTATIONS_INTELLECTUELLES
}

model Sector {
  id    String      @id @default(cuid())
  group SectorGroup
  name  String
  code  String?

  subsectors     Subsector[]
  markets        Market[]
  tenantSectors  TenantSector[]
  companySectors CompanySector[]
  ppmItems       PpmItem[]

  @@unique([group, name])
}

model Subsector {
  id       String @id @default(cuid())
  sectorId String
  sector   Sector @relation(fields: [sectorId], references: [id])
  name     String

  markets Market[]

  @@unique([sectorId, name])
}

enum ProcedureType {
  APPEL_OFFRES_OUVERT
  APPEL_OFFRES_OUVERT_ACCELERE
  DEMANDE_PRIX
  DEMANDE_COTATION
  MANIFESTATION_INTERET
  DEMANDE_PROPOSITIONS
  DEMANDE_PROPOSITIONS_ALLEGEE
  AUTRE
}

// =====================================================================
// 4. MARCHÉS — coeur de l'architecture (section 4, 7, 8)
// =====================================================================

enum MarketStatus {
  PLANIFIE
  PUBLIE
  RECTIFIE
  ANNULE
  REPRIS
  SOUMISSIONS_CLOSES
  EN_EVALUATION
  RESULTAT_PUBLIE
  RESULTAT_RECTIFIE
  EN_RECOURS
  EN_REEXAMEN
  ATTRIBUE
  CLOTURE
}

enum PublicationType {
  AVIS_APPEL_OFFRES
  DEMANDE_PRIX
  DEMANDE_COTATION
  APPEL_OFFRES_OUVERT
  APPEL_OFFRES_ACCELERE
  MANIFESTATION_INTERET
  DEMANDE_PROPOSITIONS
  RESULTAT_PROVISOIRE
  ATTRIBUTION
  RECTIFICATIF
  ANNULATION
  REPRISE
  REEXAMEN
  DECISION_RECOURS
  AVIS_GENERAL_PASSATION
  PLAN_PASSATION
}

enum FinancingSource {
  EXTERIEUR
  NATIONAL
  COMMUNAL
  AUTRE
}

enum ProcurementRegime {
  NATIONAL
  BANQUE_MONDIALE
  BAD
  KFW
  UNION_EUROPEENNE
  AUTRE
}

model Donor {
  id               String             @id @default(cuid())
  name             String             @unique
  regimeProcedural ProcurementRegime? // chaque bailleur impose son propre jeu de règles (section 5.1)

  fundings Funding[]
}

model Project {
  id   String @id @default(cuid())
  name String

  fundings Funding[]
  ppmItems PpmItem[]
}

model Market {
  id              String          @id @default(cuid())
  reference       String? // référence officielle
  procedureNumber String?
  title           String
  description     String? @db.Text
  publicationType PublicationType
  procedureType   ProcedureType
  sectorId        String?
  sector          Sector?         @relation(fields: [sectorId], references: [id])
  subsectorId     String?
  subsector       Subsector?      @relation(fields: [subsectorId], references: [id])
  keywords        Json     @default("[]") // string[] — MySQL n'a pas de type tableau natif
  status          MarketStatus    @default(PUBLIE)
  currentVersion  Int             @default(1)

  contractingAuthorityId String
  contractingAuthority   ContractingAuthority @relation(fields: [contractingAuthorityId], references: [id])

  // Financement
  financingSource FinancingSource?
  financingDetail String? @db.Text

  // Montants (section "Montants" — stockés séparément)
  amountEstimatedExclTax Decimal? @db.Decimal(18, 2)
  amountEstimatedInclTax Decimal? @db.Decimal(18, 2)
  amountRead             Decimal? @db.Decimal(18, 2)
  amountCorrected        Decimal? @db.Decimal(18, 2)
  amountAfterDiscount    Decimal? @db.Decimal(18, 2)
  amountAwarded          Decimal? @db.Decimal(18, 2)
  amountInitial          Decimal? @db.Decimal(18, 2)
  amountFinal            Decimal? @db.Decimal(18, 2)
  currency               String   @default("XOF")

  // Localisation
  regionId   String?
  region     Region? @relation(fields: [regionId], references: [id])
  siteDetail String? @db.Text

  // Calendrier
  publishedAt        DateTime?
  withdrawalDeadline DateTime?
  submissionDeadline DateTime?
  submissionTime     String?
  openingAt          DateTime?
  bidValidityDays    Int?
  executionDelayDays Int?
  resultAt           DateTime?

  // Traçabilité source (section 2.1)
  sourcePublicationId String?
  sourceDocumentId    String?
  sourcePage          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots              MarketLot[]
  events            MarketEvent[]
  versions          MarketVersion[]
  corrections       Correction[]
  cancellations     Cancellation[]
  republications    Republication[]
  requirements      Requirement[]
  requiredDocuments MarketRequiredDocument[]
  reservations      MarketReservation[]
  bids              Bid[]
  results           Result[]
  appeals           Appeal[]
  reviews           Review[]
  fundings          Funding[]
  notices           Notice[]
  scores            Score[]
  matchResults      MatchResult[]
  recommendations   Recommendation[]
  watchlistItems    WatchlistTarget[]
  ppmItems          PpmItem[]

  @@index([status])
  @@index([publishedAt])
  @@index([submissionDeadline])
  @@index([contractingAuthorityId])
  @@index([sectorId])
}

model MarketLot {
  id                    String       @id @default(cuid())
  marketId              String
  market                Market       @relation(fields: [marketId], references: [id])
  numero                String
  objet                 String
  description           String? @db.Text
  montant               Decimal?     @db.Decimal(18, 2)
  regionId              String?
  quantite              Float?
  unite                 String?
  status                MarketStatus @default(PUBLIE)
  attributaireCompanyId String?
  attributaire          Company?     @relation(fields: [attributaireCompanyId], references: [id])

  // Section 3.4 & 10.3 : rabattement environnemental (PGES) et fourchette
  // de garantie de bonne exécution (30 à 40%, jamais un taux fixe).
  criterePges              Boolean @default(false)
  tauxRabattementPgesPct   Float?
  tauxGarantieExecutionPct Float?

  bids              Bid[]
  results           Result[]
  requirements      Requirement[]
  requiredDocuments MarketRequiredDocument[]
  reservations      MarketReservation[]

  @@unique([marketId, numero])
}

// Historique des versions (snapshot complet à chaque événement majeur)
model MarketVersion {
  id            String   @id @default(cuid())
  marketId      String
  market        Market   @relation(fields: [marketId], references: [id])
  versionNumber Int
  snapshot      Json
  eventId       String?
  createdAt     DateTime @default(now())

  @@unique([marketId, versionNumber])
}

// Journal d'événements métier — Annexe B
enum MarketEventType {
  MARKET_CREATED
  MARKET_UPDATED
  MARKET_CORRECTED
  MARKET_CANCELLED
  MARKET_REPUBLISHED
  MARKET_EXTENDED
  BID_SUBMITTED
  BID_EVALUATED
  RESULT_PUBLISHED
  RESULT_CORRECTED
  APPEAL_FILED
  APPEAL_DECIDED
  REVIEW_REQUESTED
  REVIEW_COMPLETED
  AWARD_PUBLISHED
  PPM_CREATED
  PPM_UPDATED
  OPPORTUNITY_MATCHED
  ALERT_CREATED
  ALERT_SENT
}

model MarketEvent {
  id               String          @id @default(cuid())
  marketId         String
  market           Market          @relation(fields: [marketId], references: [id])
  type             MarketEventType
  payload          Json?
  occurredAt       DateTime
  sourceDocumentId String?
  sourceDocument   Document?       @relation(fields: [sourceDocumentId], references: [id])
  description      String? @db.Text
  createdAt        DateTime        @default(now())

  @@index([marketId, occurredAt])
}

// Avis publié rattaché à un marché (un marché peut avoir plusieurs avis
// au fil de sa vie : initial, rectificatif publié comme nouvel avis, etc.)
model Notice {
  id              String          @id @default(cuid())
  marketId        String
  market          Market          @relation(fields: [marketId], references: [id])
  publicationId   String
  publication     Publication     @relation(fields: [publicationId], references: [id])
  documentId      String
  document        Document        @relation(fields: [documentId], references: [id])
  pageNumber      Int?
  publicationType PublicationType
  publishedAt     DateTime
  rawExcerpt      String? @db.Text
  createdAt       DateTime        @default(now())

  @@index([marketId])
}

model Correction {
  id               String    @id @default(cuid())
  marketId         String
  market           Market    @relation(fields: [marketId], references: [id])
  fieldChanged     String
  beforeValue      String? @db.Text
  afterValue       String? @db.Text
  effectiveAt      DateTime
  consequence      String? @db.Text
  sourceDocumentId String?
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id])
  createdAt        DateTime  @default(now())

  @@index([marketId])
}

model Cancellation {
  id                 String    @id @default(cuid())
  marketId           String
  market             Market    @relation(fields: [marketId], references: [id])
  motif              String @db.Text
  cancelledAt        DateTime
  procedureConcerned String?
  sourceDocumentId   String?
  sourceDocument     Document? @relation(fields: [sourceDocumentId], references: [id])
  createdAt          DateTime  @default(now())
}

model Republication {
  id               String    @id @default(cuid())
  marketId         String
  market           Market    @relation(fields: [marketId], references: [id])
  originalEventId  String?
  republishedAt    DateTime
  sourceDocumentId String?
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id])
  createdAt        DateTime  @default(now())
}

// =====================================================================
// 5. EXIGENCES & DOCUMENTS REQUIS (sections 9, 10)
// =====================================================================

enum RequirementType {
  CHIFFRE_AFFAIRES
  EXPERIENCE_GENERALE
  EXPERIENCE_SPECIFIQUE
  REFERENCES
  AGREMENT
  CAPACITE_FINANCIERE
  CAPACITE_TECHNIQUE
  PERSONNEL
  DIPLOMES
  CERTIFICATIONS
  EQUIPEMENTS
  MOYENS_MATERIELS
  DELAI
  GARANTIES
  PIECES_ADMINISTRATIVES
  DOCUMENTS_TECHNIQUES
  CONDITIONS_GEOGRAPHIQUES
  CONDITIONS_RESERVATION
  CERTIFICATION
  CRITERE_ENVIRONNEMENTAL
  AUTRE
}

model Requirement {
  id             String          @id @default(cuid())
  marketId       String
  market         Market          @relation(fields: [marketId], references: [id])
  lotId          String?
  lot            MarketLot?      @relation(fields: [lotId], references: [id])
  type           RequirementType
  rawText        String @db.Text
  thresholdValue Float?
  thresholdUnit  String?
  confidence     Float           @default(0.7)
  createdAt      DateTime        @default(now())
}

enum RequiredDocType {
  RCCM
  IFU
  ATTESTATION_FISCALE
  ATTESTATION_SOCIALE
  GARANTIE
  AGREMENT
  CERTIFICAT
  REFERENCE
  ATTESTATION_BONNE_EXECUTION
  CV
  DIPLOME
  CERTIFICAT_TECHNIQUE
  PIECE_FINANCIERE
  PIECE_ADMINISTRATIVE
  AUTRE
}

model MarketRequiredDocument {
  id        String          @id @default(cuid())
  marketId  String
  market    Market          @relation(fields: [marketId], references: [id])
  lotId     String?
  lot       MarketLot?      @relation(fields: [lotId], references: [id])
  docType   RequiredDocType
  mandatory Boolean         @default(true)
  rawText   String? @db.Text
}

enum ReservationCategory {
  PME
  ENTREPRISES_BURKINABE
  ENTREPRISES_COMMUNAUTAIRES
  FEMMES
  JEUNES
  ACTIONNARIAT_HANDICAP
  CRITERES_SPECIFIQUES
  CONSULTANTS_BURKINABE_COMMUNAUTAIRES
  AUTRE
}

model MarketReservation {
  id       String              @id @default(cuid())
  marketId String
  market   Market              @relation(fields: [marketId], references: [id])
  lotId    String?
  lot      MarketLot?          @relation(fields: [lotId], references: [id])
  category ReservationCategory
  rawText  String? @db.Text
}

// =====================================================================
// 6. ENTREPRISES (annuaire public) & RÉSOLUTION D'ENTITÉ (sections 13, 43)
// =====================================================================

enum CompanySize {
  MICRO
  PETITE
  MOYENNE
  GRANDE
}

enum TaxRegime {
  CME_MICRO
  RSI_SIMPLIFIE
  RNI_NORMAL
}

model Company {
  id            String   @id @default(cuid())
  countryId     String
  country       Country  @relation(fields: [countryId], references: [id])
  canonicalName String
  ifu           String?
  address       String?
  regionName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Enrichissement — section 3.2 et 8.11 de l'analyse structurelle
  rccm              String?
  rccmNormalise     String? // clé de rapprochement : espaces/tirets supprimés
  formeJuridique    String? // SARL, SA, Établissement, Groupement, Société coopérative
  telephones        Json         @default("[]") // string[]
  paysOrigine       String?
  estGroupement     Boolean      @default(false)
  tailleEntreprise  CompanySize?
  regimeFiscal      TaxRegime?
  representantLegal String?
  anneeCreation     Int?
  ageGerant         Int?
  disposePges       Boolean      @default(false) // Plan de Gestion Environnementale et Sociale
  dateValiditePges  DateTime?

  aliases                  CompanyAlias[]
  sectors                  CompanySector[]
  licenses                 CompanyLicense[]
  references               CompanyReference[]
  participations           CompanyParticipation[]
  bids                     Bid[]
  wonLots                  MarketLot[]
  results                  Result[]                 @relation("ResultWinner")
  appealsFiled             Appeal[]
  mergesFrom               CompanyMerge[]           @relation("MergeSource")
  mergesInto               CompanyMerge[]           @relation("MergeTarget")
  watchlistItems           WatchlistTarget[]
  supplierDirectoryEntries SupplierDirectoryEntry[]

  @@unique([countryId, canonicalName])
  @@index([ifu])
}

model CompanyAlias {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  aliasName        String
  sourceDocumentId String?
  createdAt        DateTime @default(now())

  @@unique([companyId, aliasName])
}

model CompanyMerge {
  id              String   @id @default(cuid())
  sourceCompanyId String
  sourceCompany   Company  @relation("MergeSource", fields: [sourceCompanyId], references: [id])
  targetCompanyId String
  targetCompany   Company  @relation("MergeTarget", fields: [targetCompanyId], references: [id])
  reason          String? @db.Text
  reversible      Boolean  @default(true)
  performedBy     String?
  performedAt     DateTime @default(now())
}

model CompanySector {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  sectorId  String
  sector    Sector  @relation(fields: [sectorId], references: [id])

  @@unique([companyId, sectorId])
}

model CompanyLicense {
  id                     String    @id @default(cuid())
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id])
  label                  String
  // Agrément à trois dimensions — section 5.2 de l'analyse structurelle :
  // catégorie (A, A1-A3, B1-B2, SC2, D1/D1-B/D1-C/D3/D4, U1-U2), domaine,
  // couverture géographique (une catégorie valide peut ne pas couvrir la région du marché).
  categorie              String?
  domaine                String?
  couvertureGeographique String?
  expirationDate         DateTime?
  sourceDocumentId       String?

  @@index([companyId])
}

model CompanyReference {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  marketTitle String
  clientName  String?
  year        Int?
  amount      Decimal? @db.Decimal(18, 2)

  @@index([companyId])
}

enum ParticipationRole {
  BIDDER
  WINNER
  LOSER
  DISQUALIFIED
}

model CompanyParticipation {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  marketId  String
  role      ParticipationRole
  amount    Decimal?          @db.Decimal(18, 2)
  createdAt DateTime          @default(now())

  @@index([companyId])
  @@index([marketId])
}

// =====================================================================
// 7. OFFRES, ÉVALUATION, RÉSULTATS (sections 12, 14)
// =====================================================================

enum RejectionReason {
  PIECE_ADMINISTRATIVE_ABSENTE
  AGREMENT_ABSENT
  AGREMENT_NON_CONFORME
  CARACTERISTIQUE_TECHNIQUE_NON_CONFORME
  EXPERIENCE_INSUFFISANTE
  GARANTIE_INCORRECTE
  DELAI_NON_CONFORME
  ERREUR_CALCUL
  ERREUR_QUANTITE
  OFFRE_ANORMALEMENT_BASSE
  OFFRE_ANORMALEMENT_ELEVEE
  DOCUMENT_NON_FOURNI
  PERSONNEL_NON_CONFORME
  REFERENCE_INSUFFISANTE
  AUTRE
}

enum RejectionMotifCategory {
  A_FORME_SOUMISSION
  B_CALCUL_COHERENCE
  C_ANOMALIES_FINANCIERES
  D_PIECES_ELIGIBILITE
  E_CAPACITE_TECHNIQUE
  F_SPECIFICATIONS_TECHNIQUES
  G_PRESTATIONS_INTELLECTUELLES
  H_FRAUDE_FAUSSES_DECLARATIONS
  I_TAILLE_REGIME_FISCAL
}

// Référentiel des motifs de rejet — section 9.6 : "le référentiel le plus
// précieux". Un même motif peut couvrir plusieurs offres ; une offre peut
// cumuler plusieurs motifs (Bid.rejectionMotifCodes).
model RejectionMotif {
  code      String                 @id // ex "A01", "H07"
  category  RejectionMotifCategory
  label     String
  gravite   Int                    @default(1) // 1 = mineur, 3 = éliminatoire systématique
  evitable  Boolean                @default(true) // le soumissionnaire aurait pu l'éviter
  createdAt DateTime               @default(now())
}

model Bid {
  id                  String           @id @default(cuid())
  marketId            String
  market              Market           @relation(fields: [marketId], references: [id])
  lotId               String?
  lot                 MarketLot?       @relation(fields: [lotId], references: [id])
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id])
  // Trois montants distincts — section 3.7 : les confondre fausse toute
  // statistique de prix. montant_soumissionne = amountRead ; montant_corrige
  // = après corrections arithmétiques CAM ; montant_attribue = après
  // augmentation de quantités (jusqu'à 15% de la réglementation).
  amountRead          Decimal?         @db.Decimal(18, 2)
  amountCorrected     Decimal?         @db.Decimal(18, 2)
  amountAwarded       Decimal?         @db.Decimal(18, 2)
  awardIncreasePct    Float? // taux d'augmentation attribué vs corrigé, ex. 14.93
  conformity          Boolean?
  rank                Int?
  rejectionReason     RejectionReason?
  rejectionMotifCodes Json     @default("[]") // string[] — codes du référentiel RejectionMotif, cumulables
  rejectionDetail     String? @db.Text
  submittedAt         DateTime?
  createdAt           DateTime         @default(now())

  corrections BidCorrection[]
  evaluation  Evaluation?

  @@index([marketId])
  @@index([companyId])
}

model BidCorrection {
  id          String  @id @default(cuid())
  bidId       String
  bid         Bid     @relation(fields: [bidId], references: [id])
  field       String
  beforeValue String? @db.Text
  afterValue  String? @db.Text
  reason      String? @db.Text
}

model Evaluation {
  id           String @id @default(cuid())
  bidId        String @unique
  bid          Bid    @relation(fields: [bidId], references: [id])
  criteriaJson Json?
  note         Float?
  threshold    Float?
}

// Convention de calcul de l'offre anormalement basse détectée dans le
// bloc "analyse financière" — section 3.3 : au moins six variantes
// coexistent dans le corpus, avec des erreurs manifestes dans certaines.
enum OabConvention {
  CANONIQUE // M = 0,6E + 0,4P ; BI = 0,85M ; ST = 0,95BI ; BS = 1,15M
  NOMENCLATURE_INVERSEE
  SOMME_ERRONEE // M calculé comme une somme au lieu d'une moyenne pondérée
  TABLEAU_NOMME
  TOLERANCE_ALTERNATIVE // seuil de tolérance exprimé différemment (ex. 15% au lieu de 5%)
  DOUBLE_CALCUL // marchés à commandes : formule appliquée sur min ET max
  INDETERMINEE
}

model Result {
  id               String     @id @default(cuid())
  marketId         String
  market           Market     @relation(fields: [marketId], references: [id])
  lotId            String?
  lot              MarketLot? @relation(fields: [lotId], references: [id])
  numberOfBids     Int?
  meanAmount       Decimal?   @db.Decimal(18, 2)
  threshold        Decimal?   @db.Decimal(18, 2)
  envelope         Decimal?   @db.Decimal(18, 2)
  winnerCompanyId  String?
  winnerCompany    Company?   @relation("ResultWinner", fields: [winnerCompanyId], references: [id])
  awardedAmount    Decimal?   @db.Decimal(18, 2)
  decision         String? @db.Text
  resultAt         DateTime
  isCorrected      Boolean    @default(false)
  sourceDocumentId String?
  sourceDocument   Document?  @relation(fields: [sourceDocumentId], references: [id])
  createdAt        DateTime   @default(now())

  // Moteur OAB multi-conventions — section 3.3 & 10.1. On ne corrige jamais
  // la donnée officielle : on la signale (scoreCoherence < 0,7 ⇒ exclue de
  // l'estimateur de prix, marquée "seuils potentiellement erronés").
  seuil085M          Decimal?       @db.Decimal(18, 2) // borne inférieure / plancher OAB
  seuil115M          Decimal?       @db.Decimal(18, 2) // borne supérieure
  seuilTolerance5pct Decimal?       @db.Decimal(18, 2)
  oabConvention      OabConvention?
  scoreCoherence     Float? // 1.0 = cohérent ; < 0.7 = seuils potentiellement erronés

  @@index([marketId])
  @@index([winnerCompanyId])
}

// =====================================================================
// 8. RECOURS & RÉEXAMEN (section 15)
// =====================================================================

enum AppealType {
  RECOURS_PREALABLE // devant l'autorité contractante
  RECOURS_ARCOP // décision de l'organe de régulation (ORD/CRD)
}

enum ArcopOrgane {
  ORD
  CRD
}

model Appeal {
  id                 String       @id @default(cuid())
  marketId           String
  market             Market       @relation(fields: [marketId], references: [id])
  requesterCompanyId String?
  requesterCompany   Company?     @relation(fields: [requesterCompanyId], references: [id])
  object             String
  filedAt            DateTime
  authority          String?
  resultBefore       String? @db.Text
  resultAfter        String? @db.Text
  // Recours ARCOP — section 3.5 : taux de recours par autorité, taux de
  // succès, délai moyen sont des indicateurs qu'aucun concurrent ne détient.
  appealType         AppealType?
  referenceDecision  String? // ex "N°2026-L0308/ARCOP/ORD"
  organeDecision     ArcopOrgane?
  sourceDocumentId   String?
  sourceDocument     Document?    @relation(fields: [sourceDocumentId], references: [id])
  createdAt          DateTime     @default(now())

  decisions AppealDecision[]
}

model AppealDecision {
  id          String   @id @default(cuid())
  appealId    String
  appeal      Appeal   @relation(fields: [appealId], references: [id])
  decision    String @db.Text
  decidedAt   DateTime
  consequence String? @db.Text
}

model Review {
  id          String    @id @default(cuid())
  marketId    String
  market      Market    @relation(fields: [marketId], references: [id])
  requestedAt DateTime?
  completedAt DateTime?
  outcome     String?
}

// =====================================================================
// 9. FINANCEMENT / PROJETS (section "Financement")
// =====================================================================

model Funding {
  id        String          @id @default(cuid())
  marketId  String
  market    Market          @relation(fields: [marketId], references: [id])
  source    FinancingSource
  donorId   String?
  donor     Donor?          @relation(fields: [donorId], references: [id])
  projectId String?
  project   Project?        @relation(fields: [projectId], references: [id])
  budget    Decimal?        @db.Decimal(18, 2)
}

// =====================================================================
// 10. PPM & AVIS GÉNÉRAUX (section 16)
// =====================================================================

enum PpmStatus {
  PLANIFIE
  AVIS_GENERAL_PUBLIE
  AVIS_MARCHE_PUBLIE
  EN_SOUMISSION
  EN_EVALUATION
  RESULTAT
  ATTRIBUE
}

model PpmPlan {
  id                     String               @id @default(cuid())
  contractingAuthorityId String
  contractingAuthority   ContractingAuthority @relation(fields: [contractingAuthorityId], references: [id])
  exercice               Int
  publicationId          String?
  publication            Publication?         @relation(fields: [publicationId], references: [id])
  status                 PpmStatus            @default(PLANIFIE)
  createdAt              DateTime             @default(now())

  items PpmItem[]
}

model PpmItem {
  id               String           @id @default(cuid())
  planId           String
  plan             PpmPlan          @relation(fields: [planId], references: [id])
  object           String
  sectorId         String?
  sector           Sector?          @relation(fields: [sectorId], references: [id])
  procedureType    ProcedureType?
  budget           Decimal?         @db.Decimal(18, 2)
  periodPlanned    String?
  financingSource  FinancingSource?
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id])
  status           PpmStatus        @default(PLANIFIE)
  linkedMarketId   String?
  linkedMarket     Market?          @relation(fields: [linkedMarketId], references: [id])
  sourceDocumentId String?
  sourceDocument   Document?        @relation(fields: [sourceDocumentId], references: [id])

  @@index([planId])
}

model GeneralNotice {
  id                     String               @id @default(cuid())
  contractingAuthorityId String
  contractingAuthority   ContractingAuthority @relation(fields: [contractingAuthorityId], references: [id])
  exercice               Int
  publicationId          String
  publication            Publication          @relation(fields: [publicationId], references: [id])
  publishedAt            DateTime
}

// =====================================================================
// 10 bis. RÉPERTOIRES DE FOURNISSEURS (objets REP) — section 3.1
// Gisement le plus immédiatement exploitable : identité, IFU/RCCM,
// dirigeant, téléphone, secteur — table `entreprises` pré-remplie sans
// attendre l'accumulation par les résultats, et fichier de prospection.
// =====================================================================

enum SupplierDirectoryStatus {
  PUBLIE
  RECTIFIE
}

model SupplierDirectory {
  id                     String                  @id @default(cuid())
  contractingAuthorityId String
  contractingAuthority   ContractingAuthority    @relation(fields: [contractingAuthorityId], references: [id])
  title                  String // ex "Répertoire des prestataires — exercice 2026"
  domaine                String? // domaine de référencement = secteur natif, sans classification
  exercices              Json                    @default("[]") // string[] — ex ["2026","2027","2028"]
  status                 SupplierDirectoryStatus @default(PUBLIE)
  publicationId          String?
  publication            Publication?            @relation(fields: [publicationId], references: [id])
  sourceDocumentId       String?
  sourceDocument         Document?               @relation(fields: [sourceDocumentId], references: [id])
  createdAt              DateTime                @default(now())

  entries SupplierDirectoryEntry[]
}

model SupplierDirectoryEntry {
  id                String            @id @default(cuid())
  directoryId       String
  directory         SupplierDirectory @relation(fields: [directoryId], references: [id])
  pliNumber         String? // numéro de pli dans le répertoire
  companyId         String?
  company           Company?          @relation(fields: [companyId], references: [id])
  rawName           String // raison sociale telle que publiée, avant résolution d'entité
  ifu               String?
  rccm              String?
  representantLegal String?
  telephone         String?
  ville             String?
  anneeCreation     Int?
  agrement          String?
  createdAt         DateTime          @default(now())

  @@index([directoryId])
  @@index([companyId])
}

// =====================================================================
// 11. SAAS — TENANTS, UTILISATEURS, RBAC (section 17, 49)
// =====================================================================

enum TenantRole {
  OWNER
  ADMIN
  ANALYST
  COLLABORATOR
  READONLY
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

model Tenant {
  id               String   @id @default(cuid())
  countryId        String
  country          Country  @relation(fields: [countryId], references: [id])
  name             String // raison sociale
  sectorId         String?
  regionName       String?
  size             String?
  revenueBand      String?
  experienceYears  Int?
  preferences      Json?
  targetCategories Json     @default("[]") // string[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members         TenantMember[]
  sectors         TenantSector[]
  licenses        TenantLicense[]
  references      TenantReference[]
  equipment       TenantEquipment[]
  personnel       TenantPersonnel[]
  certifications  TenantCertification[]
  zones           TenantZone[]
  documents       TenantDocument[]
  watchlists      Watchlist[]
  alerts          Alert[]
  scores          Score[]
  matchResults    MatchResult[]
  recommendations Recommendation[]
  subscription    Subscription?
  folders         SubmissionFolder[]
  aiConversations AiConversation[]
  auditLogs       AuditLog[]

  @@unique([countryId, name])
}

model TenantSector {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  sectorId String
  sector   Sector @relation(fields: [sectorId], references: [id])

  @@unique([tenantId, sectorId])
}

model TenantLicense {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  label          String
  expirationDate DateTime?
}

model TenantReference {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  marketTitle String
  clientName  String?
  year        Int?
  amount      Decimal? @db.Decimal(18, 2)
}

model TenantEquipment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  label    String
  quantity Int?
}

model TenantPersonnel {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  role     String
  count    Int?
  diplomas String?
}

model TenantCertification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  label    String
}

model TenantZone {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  regionName String
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?
  passwordHash    String
  fullName        String
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     TenantMember[]
  aiConversations AiConversation[]
  auditLogs       AuditLog[]
  loginEvents     LoginEvent[]
  validations     DataQualityCheck[]
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  role      TenantRole @default(COLLABORATOR)
  invitedAt DateTime   @default(now())
  joinedAt  DateTime?

  @@unique([tenantId, userId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
}

// =====================================================================
// 12. VEILLE — WATCHLISTS, ALERTES, NOTIFICATIONS (sections 30, 31, 83)
// =====================================================================

enum WatchlistType {
  MARKET
  ORGANIZATION
  COMPANY
  SECTOR
  PROJECT
  REGION
  KEYWORD
}

model Watchlist {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  type      WatchlistType
  keyword   String?
  createdAt DateTime      @default(now())

  targets WatchlistTarget[]
}

// table de jonction générique — cible marché ou entreprise
model WatchlistTarget {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id])
  marketId    String?
  market      Market?   @relation(fields: [marketId], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
}

enum AlertType {
  NEW_MATCHING_MARKET
  DEADLINE_APPROACHING
  CORRECTION
  CANCELLATION
  RESULT
  AWARD
  APPEAL
  REVIEW
  PPM_MATCH
  DOCUMENT_EXPIRING
  NEW_TREND
}

enum AlertPriority {
  CRITIQUE
  IMPORTANTE
  NORMALE
  INFORMATION
}

model Alert {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  type            AlertType
  priority        AlertPriority @default(NORMALE)
  title           String
  body            String? @db.Text
  relatedMarketId String?
  dedupeKey       String?
  readAt          DateTime?
  createdAt       DateTime      @default(now())

  notifications Notification[]

  @@index([tenantId, createdAt])
  @@index([dedupeKey])
}

enum NotificationChannel {
  APP
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Notification {
  id      String              @id @default(cuid())
  alertId String
  alert   Alert               @relation(fields: [alertId], references: [id])
  channel NotificationChannel
  status  NotificationStatus  @default(QUEUED)
  sentAt  DateTime?
  error   String? @db.Text
}

// =====================================================================
// 13. SCORING & RECOMMANDATIONS (sections 18, 19, 73)
// =====================================================================

model ScoreConfig {
  id            String   @id @default(cuid())
  version       String   @unique // ex "1.0"
  weights       Json // structure section 73
  isActive      Boolean  @default(false)
  effectiveFrom DateTime @default(now())
  createdBy     String?
  createdAt     DateTime @default(now())
}

model Score {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  marketId     String
  market       Market   @relation(fields: [marketId], references: [id])
  scoreVersion String
  pertinence   Float
  eligibilite  Float
  attractivite Float
  global       Float
  factors      Json
  computedAt   DateTime @default(now())

  @@unique([tenantId, marketId, scoreVersion])
  @@index([tenantId, global])
}

enum MatchVerdict {
  COMPATIBLE
  PROBABLEMENT_COMPATIBLE
  A_VERIFIER
  INCOMPATIBLE
}

model MatchResult {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  marketId   String
  market     Market       @relation(fields: [marketId], references: [id])
  verdict    MatchVerdict
  reasons    Json
  computedAt DateTime     @default(now())

  @@unique([tenantId, marketId])
}

model Recommendation {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id])
  rank        Int
  reason      Json
  generatedAt DateTime @default(now())

  @@index([tenantId, rank])
}

// =====================================================================
// 14. ABONNEMENTS & PAIEMENTS (sections 50, 51)
// =====================================================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id               String             @id @default(cuid())
  tenantId         String             @unique
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  plan             PlanTier           @default(FREE)
  status           SubscriptionStatus @default(TRIAL)
  currentPeriodEnd DateTime?
  gracePeriodEnd   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]
}

enum PaymentProvider {
  MOBILE_MONEY
  CARD
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  provider       PaymentProvider
  amount         Decimal         @db.Decimal(18, 2)
  currency       String          @default("XOF")
  status         PaymentStatus   @default(PENDING)
  externalRef    String?
  receiptUrl     String?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
}

// =====================================================================
// 15. DOSSIERS DE SOUMISSION (sections 81, 82)
// =====================================================================

enum DocumentLifecycleStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
  MISSING
  UNVERIFIED
}

model TenantDocument {
  id             String                  @id @default(cuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  docType        RequiredDocType
  label          String?
  fileUrl        String?
  expirationDate DateTime?
  status         DocumentLifecycleStatus @default(UNVERIFIED)
  confidence     Float?
  lastVerifiedAt DateTime?
  createdAt      DateTime                @default(now())

  folderDocuments FolderDocument[]
}

model SubmissionFolder {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  marketId  String
  status    String   @default("OUVERT")
  notes     String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist ChecklistItem[]
  documents FolderDocument[]

  @@unique([tenantId, marketId])
}

model ChecklistItem {
  id       String           @id @default(cuid())
  folderId String
  folder   SubmissionFolder @relation(fields: [folderId], references: [id])
  label    String
  done     Boolean          @default(false)
  dueDate  DateTime?
}

model FolderDocument {
  id               String                  @id @default(cuid())
  folderId         String
  folder           SubmissionFolder        @relation(fields: [folderId], references: [id])
  requiredDocType  RequiredDocType?
  tenantDocumentId String?
  tenantDocument   TenantDocument?         @relation(fields: [tenantDocumentId], references: [id])
  status           DocumentLifecycleStatus @default(MISSING)
}

// =====================================================================
// 16. ASSISTANT IA (sections 28, 89, 90)
// =====================================================================

model AiConversation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime @default(now())

  messages AiMessage[]
}

enum AiRole {
  USER
  ASSISTANT
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  role           AiRole
  content        String @db.Text
  confidence     String? // "élevée" | "moyenne" | "faible"
  createdAt      DateTime       @default(now())

  sources AiSource[]
}

model AiSource {
  id         String    @id @default(cuid())
  messageId  String
  message    AiMessage @relation(fields: [messageId], references: [id])
  entityType String // "market" | "document" | "result" ...
  entityId   String
  excerpt    String? @db.Text
}

// =====================================================================
// 17. QUALITÉ DES DONNÉES & AUDIT (sections 44, 45, 46, 60, 61, 93)
// =====================================================================

enum ExtractionJobStage {
  DOWNLOAD
  OCR
  PARSE
  CLASSIFY
  EXTRACT
  VALIDATE
}

enum ExtractionJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
}

model ExtractionJob {
  id           String              @id @default(cuid())
  documentId   String
  document     Document            @relation(fields: [documentId], references: [id])
  stage        ExtractionJobStage
  status       ExtractionJobStatus @default(PENDING)
  attempts     Int                 @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([documentId])
  @@index([status])
}

enum DataQualityStatus {
  EXTRAIT_AUTOMATIQUEMENT
  VALIDE
  CORRIGE
  INCERTAIN
  REJETE
}

model DataQualityCheck {
  id               String            @id @default(cuid())
  entityType       String
  entityId         String
  field            String
  status           DataQualityStatus @default(EXTRAIT_AUTOMATIQUEMENT)
  confidence       Float?
  extractionMethod String?
  validatedById    String?
  validatedBy      User?             @relation(fields: [validatedById], references: [id])
  validatedAt      DateTime?
  createdAt        DateTime          @default(now())

  @@index([entityType, entityId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  occurredAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([occurredAt])
}

// Déduplication globale par hash de bloc — section 1.3 de l'analyse
// structurelle : un encart publicitaire ou un résultat peut être republié
// à l'identique d'un numéro à l'autre (ex. SONATUR dans les n°4484 et
// n°4485). Un hash déjà vu ⇒ pas de nouvel enregistrement, on journalise.
model BlockHash {
  hash       String   @id
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model AnalyticsSnapshot {
  id           String   @id @default(cuid())
  dimension    String // ex "sector", "region", "authority"
  dimensionKey String
  metric       String // ex "market_count", "total_amount"
  period       String // ex "2026-W35", "2026-08"
  value        Decimal  @db.Decimal(18, 2)
  computedAt   DateTime @default(now())

  @@unique([dimension, dimensionKey, metric, period])
  @@index([dimension, period])
}
