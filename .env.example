DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fasopmi?schema=public"

# NextAuth — générer une vraie valeur en production : `openssl rand -base64 32`
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Fournisseur IA (optionnel). Sans clé, l'assistant fonctionne en mode dégradé
# "sources uniquement, sans génération" plutôt que d'inventer du texte.
ANTHROPIC_API_KEY=""

# Ingestion
DGCMEF_BASE_URL="https://www.dgcmef.gov.bf"

# Email (optionnel). Sans SMTP_URL, les emails sont journalisés en console
# et les liens de vérification/réinitialisation sont affichés à l'écran.
SMTP_URL=""
